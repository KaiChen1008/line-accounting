# Local Wrangler development only.
# Copy this file to .env and replace every placeholder.
# Do not commit .env. Do not use .env and .dev.vars at the same time.

LINE_CHANNEL_SECRET="replace-with-line-channel-secret"
LINE_CHANNEL_ACCESS_TOKEN="replace-with-line-channel-access-token"
GEMINI_API_KEY="replace-with-gemini-api-key"

# Paste the complete Google service-account JSON as one dotenv value.
# Keep the private_key newline escapes (\\n) inside the JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"replace-with-google-project-id","private_key_id":"replace-with-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-with-private-key\\n-----END PRIVATE KEY-----\\n","client_email":"replace-with-service-account@replace-with-google-project-id.iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token"}'
